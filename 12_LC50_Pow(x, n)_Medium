//Implement pow(x, n), which calculates x raised to the power n (i.e., xn).

class Solution {

    public double myPow(double x, int n) {

        if (n < 0) {
            return 1.0 / quickPower(x, -(long) n);
        }

        return quickPower(x, n);
    }

    private double quickPower(double base, long exponent) {

        double result = 1.0;

        while (exponent > 0) {

            if ((exponent & 1) == 1) {
                result = result * base;
            }

            base = base * base;

            exponent >>= 1;
        }

        return result;
    }
}
